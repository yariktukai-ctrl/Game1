var consentTemplates={};consentTemplates["main-tpl"]='<div class="auth-popup__container auth-popup__container_alter auth-popup__container_visible"><div class="auth-popup auth-popup_special auth-popup_base-alter auth-popup_width_full"><div class="auth-popup__content"><div class="auth-form"><div class="auth-form__title auth-form__title_base auth-form__title_nocondensed auth-form__title_condensed-other">Мы используем cookie, чтобы сделать сайт удобнее</div><div class="auth-form__description auth-form__description_primary auth-form__description_base-additional auth-form__description_condensed">Мы обрабатываем cookie, чтобы ваш веб-серфинг шел как по маслу, а скидки и рекомендации для вас были точно в яблочко!&nbsp;<br class="helpers_hide_tablet">Хотите адаптировать настройки под себя? <a id="cookie-setting-button"class="auth-form__link auth-form__link_primary auth-form__link_base-additional">Настроить Cookies</a></div><div class="auth-form__control auth-form__control_confirm auth-form__control_condensed-alter"><a id="reject-button"class="auth-button auth-button_other auth-button_base auth-form__button">Отклонить </a><a id="submit-button"class="auth-button auth-button_expletive auth-button_base auth-form__button">Принять все cookie</a></div><div class="auth-form__description auth-form__description_other auth-form__description_small auth-form__description_condensed">Ознакомиться со <a target="_blank"href="https://blog.onliner.by/spisok-fajlov-cookie"class="auth-form__link auth-form__link_primary auth-form__link_small">списком cookie-файлов</a> и <a target="_blank"href="https://blog.onliner.by/politika-v-otnoshenii-obrabotki-cookie-fajlov"class="auth-form__link auth-form__link_primary auth-form__link_small">Политикой в отношении обработки cookie-файлов</a></div></div></div></div></div>';consentTemplates["settings-tpl"]='<div class="auth-popup__container auth-popup__container_visible"><div id="popup-overlay"class="auth-popup__overlay auth-popup__overlay_primary"></div><div 